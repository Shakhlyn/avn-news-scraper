# Copy to .env (gitignored). Password: POSTGRES_PASSWORD in avn_postgres_db/pg-stack/.env.
# From a container on the avnnet network, use host db and port 5432 instead.
DATABASE_URL=postgresql://avn:CHANGE_ME@localhost:5435/avndb
# on: all news, Accept and manual scrapes (like staging).
# Empty: accepted stories only, read-only (like production).
AVN_REVIEW=on
# Required. Sites allowed to call the API from a browser, as a JSON list.
# Local: the AVN dev server. Production: the site's own address, e.g. ["https://avnbd.org"].
CORS_ORIGINS=["http://localhost:4321","http://127.0.0.1:4321"]
# Required. The names this service answers to, as a JSON list, without port or scheme.
# Local: as below. Production: the name the requests arrive with, e.g. ["news-api.avnbd.org"]. * is refused.
ALLOWED_HOSTS=["localhost","127.0.0.1","::1","[::1]"]
# Required. The most database connections the API holds at once.
DB_POOL_MAX=10
# Tests create a throwaway schema here and drop it afterwards.
TEST_DATABASE_URL=postgresql://avn:CHANGE_ME@localhost:5435/avndb
