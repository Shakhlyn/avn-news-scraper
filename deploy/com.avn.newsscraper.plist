<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS launchd job. launchd uses the Mac's local time: 07:00 below assumes the Mac
     is set to Asia/Dhaka. If not, change Hour/Minute (e.g. 01:00 for UTC).
     Install:
       edit the two paths below to your checkout, then
       cp deploy/com.avn.newsscraper.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.avn.newsscraper.plist
     A job missed while the Mac sleeps runs when it wakes. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.avn.newsscraper</string>
  <key>WorkingDirectory</key><string>/Users/YOURNAME/avn_news_scraper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOURNAME/avn_news_scraper/.venv/bin/avn</string>
    <string>run</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/YOURNAME/avn_news_scraper/data/logs/launchd.log</string>
  <key>StandardErrorPath</key><string>/Users/YOURNAME/avn_news_scraper/data/logs/launchd.log</string>
</dict>
</plist>
