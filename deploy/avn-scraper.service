# systemd user service. Install (Linux):
#   mkdir -p ~/.config/systemd/user
#   cp deploy/avn-scraper.service deploy/avn-scraper.timer ~/.config/systemd/user/
#   # edit WorkingDirectory/ExecStart below to your checkout path, then:
#   systemctl --user daemon-reload && systemctl --user enable --now avn-scraper.timer
#   loginctl enable-linger $USER     # run even when you are not logged in
# Check:  systemctl --user list-timers ; journalctl --user -u avn-scraper
[Unit]
Description=AVN human-rights news scraper

[Service]
Type=oneshot
WorkingDirectory=%h/project/office/side-project/avn/avn_news_scraper
# After boot/resume the catch-up run can start before the network is up: wait up to 5 min.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do getent hosts www.prothomalo.com >/dev/null && exit 0; sleep 10; done; exit 0'
ExecStart=%h/project/office/side-project/avn/avn_news_scraper/.venv/bin/avn run
TimeoutStartSec=1h
